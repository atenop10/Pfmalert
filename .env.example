# Copy to .env and fill in. Never commit .env to GitHub.
BOT_TOKEN=123456789:replace_with_token_from_botfather
# Your Telegram numeric user ID(s), comma separated (get it from @userinfobot)
ADMIN_IDS=123456789
# Optional: only these chat IDs (plus admins) may use the bot. Leave empty for public.
ALLOWED_CHAT_IDS=
POLL_MINUTES=20
MAX_FOLLOWS=20
# 1 = DM admins every time the bot starts, 0 = silent
NOTIFY_ON_START=1
