[Unit]
Description=Pocket FM episode alert bot
After=network-online.target
Wants=network-online.target

[Service]
# Change "botuser" and the paths below to match your server
User=botuser
WorkingDirectory=/home/botuser/pocketfm-alert-bot
EnvironmentFile=/home/botuser/pocketfm-alert-bot/.env
ExecStart=/home/botuser/pocketfm-alert-bot/.venv/bin/python pocketfm_bot.py
Restart=always
RestartSec=10
# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
